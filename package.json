{
  "name": "homepage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build --base ./",
    "preview": "vite preview --host",
    "test": "node --test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package:runtime": "node scripts/package-runtime.mjs",
    "deploy:c": "bash scripts/deploy-to-c.sh"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "prettier": "^3.0.0",
    "vite": "^8.0.10"
  }
}
